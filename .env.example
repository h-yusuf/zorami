# Salin file ini jadi .env dan isi sesuai environment kamu.
# .env tidak pernah di-commit (lihat .gitignore).

# --- Database ---
# Default ini cocok buat dev lokal (docker compose up -d postgres).
# Kalau app juga dijalankan lewat docker compose, ganti host "localhost" jadi "postgres".
ZORA_DATABASE_URL=postgresql+asyncpg://zora:zora_dev_only@localhost:5432/zora_bridge

# --- Kunci enkripsi (BYOK secrets, Fernet) ---
# WAJIB diganti di luar dev lokal. Minimal 32 karakter.
ZORA_SECRET_KEY=dev-only-change-me-32-bytes-min!!

# --- JWT (auth dashboard) ---
# WAJIB diganti di luar dev lokal.
ZORA_JWT_SECRET=dev-only-jwt-secret-change-me-32b!!

# --- LLM: omnirouter (OpenAI-compatible) ---
ZORA_OMNIROUTER_BASE_URL=http://localhost:20128/v1
ZORA_OMNIROUTER_API_KEY=
ZORA_OMNIROUTER_MODEL=claude-sonnet-5

# --- STT: Groq Whisper ---
ZORA_GROQ_API_KEY=

# --- TTS: Piper (lokal, gratis) ---
# `uv add piper-tts` sudah nyediain binary di .venv/bin/piper. Voice Indonesia:
# `uv run python -m piper.download_voices --download-dir models id_ID-news_tts-medium`
# (satu-satunya voice id_ID yang tersedia di Piper saat ini).
ZORA_PIPER_BINARY_PATH=/absolute/path/ke/project/.venv/bin/piper
ZORA_PIPER_MODEL_PATH=/absolute/path/ke/project/models/id_ID-news_tts-medium.onnx

# --- Search: LangSearch API (BYOK - berbayar, bukan bagian arsitektur nol-biaya inti) ---
# Alternatif gratis self-host: SearxngAdapter (app/adapters/search/searxng.py) masih
# tersedia kalau mau ganti balik, cukup swap import di app/device/ws.py.
ZORA_LANGSEARCH_API_KEY=
