# Salin file ini jadi .env dan isi sesuai environment kamu.
# .env tidak pernah di-commit (lihat .gitignore).

# --- Database ---
# Default ini cocok buat dev lokal (docker compose up -d postgres).
# Kalau app juga dijalankan lewat docker compose, ganti host "localhost" jadi "postgres".
ZORA_DATABASE_URL=postgresql+asyncpg://zora:zora_dev_only@localhost:5432/zora_bridge

# --- Kunci enkripsi (BYOK secrets, Fernet) ---
# WAJIB diganti di luar dev lokal. Minimal 32 karakter.
ZORA_SECRET_KEY=dev-only-change-me-32-bytes-min!!

# --- LLM: omnirouter (OpenAI-compatible) ---
ZORA_OMNIROUTER_BASE_URL=http://localhost:20128/v1
ZORA_OMNIROUTER_API_KEY=
ZORA_OMNIROUTER_MODEL=claude-sonnet-5

# --- STT: Groq Whisper ---
ZORA_GROQ_API_KEY=

# --- TTS: Piper (lokal, gratis) ---
ZORA_PIPER_BINARY_PATH=/usr/local/bin/piper
ZORA_PIPER_MODEL_PATH=/models/id_ID-news-medium.onnx

# --- Search: SearXNG (self-host, gratis) ---
ZORA_SEARXNG_BASE_URL=http://localhost:8888
